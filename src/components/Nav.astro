---
const { current } = Astro.props;
const links = [
  { href: '/blog', label: 'posts' },
  { href: '/projects', label: 'projects' },
  { href: '/about', label: '$ whoami' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--nav-bg)] backdrop-blur-md">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-4 py-3">
    <a
      href="/"
      aria-label="0xbadcaffe home"
      class="shrink-0 py-1 text-2xl leading-7 font-semibold whitespace-nowrap text-[var(--foreground)] transition-colors hover:text-[var(--accent)]"
    >
      <span class="text-[var(--accent)]">0x</span>badcaffe
    </a>
    <details class="relative">
      <summary
        aria-label="Open navigation menu"
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-[var(--border)] bg-black/25 text-[1.35rem] leading-none text-[var(--foreground)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] [&::-webkit-details-marker]:hidden"
      >
        <span aria-hidden="true">☕</span>
      </summary>
      <nav class="absolute right-0 top-[calc(100%+0.75rem)] flex min-w-[11rem] flex-col gap-1 rounded-xl border border-[var(--border)] bg-[rgba(8,11,18,0.98)] p-2 shadow-[0_18px_40px_rgba(0,0,0,0.45)] backdrop-blur-md">
        {links.map(l => (
          <a
            href={l.href}
            class={`rounded-lg px-3 py-2 text-right font-medium transition-colors ${current === l.href ? 'bg-black/35 text-[var(--accent)]' : 'text-[var(--text-dim)] hover:bg-black/25 hover:text-[var(--foreground)]'}`}
          >
            {l.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
